# Example /etc/lionos/greeter.toml for lion-greeter 0.6.0.
#
# Copy to /etc/lionos/greeter.toml and edit. Every key is optional:
# a missing file, an unreadable file, or a syntactically broken file
# all fall back to the defaults below with one journal line — a bad
# config file can NEVER block a login.
#
# Unknown sections and keys are ignored (forward compatibility): an
# older greeter keeps booting with a newer config file.

[autologin]
# Local user to sign in without a password. Omit (or "" / "none") to
# disable autologin — the default, and the only safe default for a
# general-purpose OS.
# user = "alice"

# Grace period before the automatic sign-in fires, in milliseconds.
# The UI shows a cancellable countdown during it. 0 = immediate.
delay_ms = 0

# Whether autologin re-arms after the session ends.
#   true  — kiosk behaviour: logout bounces straight back in.
#   false — shared-machine behaviour: one auto-login per boot.
relogin = true

[session]
# Preferred desktop session id (the file stem of a .desktop file in
# /usr/share/wayland-sessions or /usr/share/x11-sessions), used when
# the UI does not carry an explicit choice. Omit to use the user's
# last-chosen session, then the compositor default.
# default = "lion"

[security]
# Pin secrets into RAM with mlockall so they can never reach swap.
# Default true. The daemon degrades gracefully (and says so through
# its Capabilities property) when the deployment's RLIMIT_MEMLOCK
# makes this impossible.
mlock = true
