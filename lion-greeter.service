[Unit]
Description=LionOS login authentication daemon
After=systemd-user-sessions.service dbus.service
Requires=dbus.socket

[Service]
Type=dbus
BusName=org.lionos.Greeter
ExecStart=/usr/bin/lion-greeter
Restart=on-failure
RestartSec=1
StateDirectory=lion-greeter
StateDirectoryMode=0755

# Runs as root only because it must PAM-authenticate and drop to arbitrary
# users; everything else is locked down.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_AUDIT_WRITE CAP_SYS_RESOURCE
# Hardening (defense in depth on top of capability drop).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
# mlockall/munlockall (secret pinning) live in @memory-lock, which is
# NOT part of @system-service — allow the group explicitly.
SystemCallFilter=@memory-lock
SystemCallFilter=~@privileged @resources @mount @swap @obsolete @cpu-emulation
# No network — the greeter only talks to the local system bus.
IPAddressDeny=any
# If LionOS ever ships with this kernel feature, hide /proc/<other-pid>.
ProcSubset=pid
# Files we never need to write to.
ReadWritePaths=/var/lib/lion-greeter /run/lion-greeter
# Resource limits — a runaway PAM stack should not OOM the system.
LimitNOFILE=256
LimitNPROC=64
# Let the daemon pin its pages (mlockall) so passwords can never reach
# swap. Infinity needs no capability — the rlimit IS the grant. The
# daemon degrades gracefully (and reports it via Capabilities) if a
# container clamps this back down, so this line is an optimization of
# the guarantee, not a load-bearing dependency.
LimitMEMLOCK=infinity

[Install]
WantedBy=graphical.target
